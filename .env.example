# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (dashboard → Settings → API Keys). Also set the 3 server values in the Convex env.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Set these in the Convex env (npx convex env set NAME value), not here ──
# BETTER_AUTH_SECRET   (openssl rand -base64 32)
# SITE_URL             (same as NEXT_PUBLIC_SITE_URL)
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
# ELECTRODARNA_API_URL (Electro Darna's https://<deployment>.convex.site)
# ELECTRODARNA_API_KEY (= CATALOG_SHARE_KEY in Electro Darna's Convex env)
